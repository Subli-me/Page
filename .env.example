# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (Dashboard → Settings → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (para notificarte por email de cada pedido nuevo)
RESEND_API_KEY=
RESEND_FROM_EMAIL=pedidos@resend.dev
ADMIN_NOTIFICATION_EMAIL=tu-email@ejemplo.com

# Printful (developers.printful.com → Your tokens → crear Private Token)
# Se usa solo para la vista previa fotorrealista (Templates API), no para fulfillment.
PRINTFUL_API_KEY=
# GET https://api.printful.com/stores con tu API key para ver el id de tu tienda.
PRINTFUL_STORE_ID=
